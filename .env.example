# The app runs with a deterministic local provider by default.
AGENT_PROVIDER=demo

# Set these values to use the real OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# SQLite file used by the local demo. Do not set this on Vercel: the app
# automatically uses its writable temporary directory there.
DATABASE_PATH=./data/zoo.db
