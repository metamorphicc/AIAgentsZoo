# The app runs with a deterministic local provider by default.
AGENT_PROVIDER=demo

# Set these values to use the real OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local libSQL file. This is for development only.
DATABASE_PATH=./data/zoo.db

# Required for durable state on Vercel. Create a Turso database (or install
# the Turso integration from the Vercel Marketplace), then set both values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated EVM addresses allowed to control the founding habitat,
# Grok runtime switch, and all public system animals.
ADMIN_WALLETS=

# Random production-only value used before IP data is hashed for rate limits.
RATE_LIMIT_SALT=
